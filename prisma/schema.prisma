// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model url {
    id  Int @id @default(autoincrement())
    clickCount Int @default(0)
    longUrl    String  
    randomCode String @unique
    createdAt  DateTime @default(now())
}
